# --- Database (Neon Postgres) ---
# Pooled connection string (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct (non-pooled) connection string, used for schema changes (prisma db push).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Sessions ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# --- First HR admin ---
# Used only while there are no staff accounts yet: logging in with these
# credentials creates the first HR admin. Change the password afterwards.
BOOTSTRAP_ADMIN_CODE="HR001"
BOOTSTRAP_ADMIN_PASSWORD="change-me-now"

# --- Public URL (used in emails and copied links) ---
APP_URL="http://localhost:3000"

# --- Time zone used in emails and CSV exports ---
APP_TIMEZONE="Asia/Kolkata"

# --- Email (SMTP) ---
# Leave SMTP_HOST empty to print emails to the server log instead of sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Maverick Events <events@example.com>"
